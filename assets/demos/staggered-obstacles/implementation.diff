+StaggeredLayout parseStaggeredLayout(const Json& c){
+    StaggeredLayout l;
+    if(c.is_object()){
+        l.width=c.value("width",l.width);l.height=c.value("height",l.height);l.depth=c.value("depth",l.depth);
+        l.spacing=c.value("spacing",l.spacing);l.lateral=c.value("lateral",l.lateral);l.firstDistance=c.value("first_distance",l.firstDistance);
+        if(c.contains("sides")&&c["sides"].is_array()&&c["sides"].size()==3)for(int i=0;i<3;++i)l.sides[i]=c["sides"][i].get<float>();
+    }
+    return l;
+}
+Json staggeredLayoutJson(const StaggeredLayout& l){
+    return {{"width",l.width},{"height",l.height},{"depth",l.depth},{"spacing",l.spacing},{"lateral",l.lateral},{"first_distance",l.firstDistance},{"sides",{l.sides[0],l.sides[1],l.sides[2]}}};
+}
+V3 jsonVec(const Json& v){return {v[0].get<float>(),v[1].get<float>(),v[2].get<float>()};}
+Json vecJson(V3 v){return {v.x,v.y,v.z};}
+}
+Json Encounter::loadStaggeredObstacles(const Json& config){
+    auto& g=*impl;auto& a=g.actors[Impl::PlayerIndex];
+    const auto fail=[&](const std::string& error){clearStaggeredObstacles();return Json{{"loaded",false},{"error",error}};};
+    clearStaggeredObstacles();
+    const auto l=parseStaggeredLayout(config);
+    if(!(l.width>0&&l.height>0&&l.depth>0))return fail("invalid obstacle dimensions");
+    if(l.spacing<=l.depth+1.0f)return fail("spacing leaves no longitudinal passage");
+    const float gap=2*(l.lateral-l.width*.5f);
+    if(gap<1.2f)return fail("central corridor narrower than 1.2 m");
+    if(l.firstDistance<2.f)return fail("first obstacle too close to the player");
+    for(float side:l.sides)if(side==0)return fail("side signs must be non-zero");
+    const size_t mapObjects=g.map.objects.size();
+    Json obstacles=Json::array();
+    for(int i=0;i<3;++i){
+        const float side=l.sides[i]>0?1.f:-1.f;
+        const V3 desired=a.pos+rotate(V3{side*l.lateral,0,l.firstDistance+i*l.spacing},a.yaw);
+        float low=1e9f,high=-1e9f;
+        for(int sz=-1;sz<=1;++sz)for(int sx=-1;sx<=1;++sx){
+            const V3 p=desired+rotate(V3{sx*l.width*.5f,0,sz*l.depth*.5f},a.yaw);
+            auto ground=g.collision.ray(p+V3{0,.8f,0},p-V3{0,1.2f,0},a.token);
+            if(!ground.hit||ground.normal.y<.95f||ground.token>mapObjects)return fail("obstacle "+std::to_string(i)+" has unsupported ground");
+            low=std::min(low,ground.point.y);high=std::max(high,ground.point.y);
+        }
+        if(high-low>.08f)return fail("obstacle "+std::to_string(i)+" ground is uneven");
+        const V3 base{desired.x,high+.005f,desired.z};
+        const Matrix volume=transform(base+V3{0,l.height*.5f,0},{l.width,l.height,l.depth},a.yaw);
+        const Matrix nav=transform(base+V3{0,l.height*.45f,0},{l.width*.98f,l.height*.9f,l.depth*.98f},a.yaw);
+        if(g.collision.overlapBox(volume,a.token))return fail("obstacle "+std::to_string(i)+" space is occupied");
+        const uint32_t t=g.token(g.coverSettings.index,CatalogObject::Exempt|CatalogObject::Rotation);
+        g.collision.setObstacle(t,&volume,&nav);g.bounds(t,volume);g.objects[t].rotation={0,a.yaw*180/Pi,0};
+        g.staggered.push_back({t,base,a.yaw,l.width,l.height,l.depth,volume,volume,nav});
+        obstacles.push_back({{"index",i},{"token",t},{"position",vecJson(base)},{"size",{l.width,l.height,l.depth}},{"yaw",a.yaw},{"side",side}});
+    }
+    g.invalidatePaths();
+    return {{"loaded",true},{"count",g.staggered.size()},{"gap_m",gap},{"config",staggeredLayoutJson(l)},{"obstacles",obstacles}};
+}
+void Encounter::clearStaggeredObstacles(){
+    for(auto& o:impl->staggered)if(o.token)impl->collision.setObstacle(o.token,nullptr);
+    impl->staggered.clear();impl->invalidatePaths();
+}
+Json Encounter::staggeredObstacleState()const{
+    Json obstacles=Json::array();
+    for(const auto& o:impl->staggered)obstacles.push_back({{"token",o.token},{"position",vecJson(o.base)},{"size",{o.width,o.height,o.depth}},{"yaw",o.yaw}});
+    return {{"active",impl->staggered.size()},{"count",impl->staggered.size()},{"obstacles",obstacles}};
+}
+bool Encounter::prepareStaggeredObstacleDemo(Json& fixture){
+    auto& g=*impl;auto& a=g.actors[Impl::PlayerIndex];
+    const V3 originalPosition=a.pos;const float originalYaw=a.yaw;
+    // Explicit demo fixture: remove NPC interference so the trajectory is deterministic.
+    for(int i=Impl::EnemyFirst;i<Impl::ActorCount;++i){auto& other=g.actors[i];other.health=0;other.deathAt=other.respawnAt=1e9;other.pos={float(i*10),-1000,0};other.shield=0;g.collision.teleport(other.body,other.pos);g.collision.setHitBoxes(other.body,other.token,{},0,nullptr);}
+    g.bullets.clear();g.nextSupply=g.nextShield=1e9;g.resetCover();
+    const StaggeredLayout layout;
+    const Json config=staggeredLayoutJson(layout);
+    const std::array<V3,8> localWaypoints={V3{0,0,0},V3{0,0,1},V3{.45f,0,layout.firstDistance},V3{0,0,layout.firstDistance+1.5f},V3{-.45f,0,layout.firstDistance+layout.spacing},V3{0,0,layout.firstDistance+layout.spacing+1.5f},V3{.45f,0,layout.firstDistance+2*layout.spacing},V3{0,0,layout.firstDistance+2*layout.spacing+2.f}};
+    for(int attempt=0;attempt<160;++attempt){
+        V3 candidate;
+        if(attempt==0)candidate=a.pos;
+        else if(!g.collision.randomPoint(g.start,2,30,g.rng,candidate))continue;
+        a.pos=candidate;g.collision.teleport(a.body,candidate);a.velocity={};a.grounded=true;a.action.clear();a.actionEnd=a.reloadEnd=0;a.crouch=false;a.anchor=candidate;
+        for(int direction=0;direction<24;++direction){
+            a.yaw=direction*Pi/12;a.pitch=0;g.pose();
+            const Json loaded=loadStaggeredObstacles(config);
+            if(!loaded.value("loaded",false))continue;
+            Json worldWaypoints=Json::array();
+            std::vector<V3> wps;
+            for(const auto& local:localWaypoints){V3 p=a.pos+rotate(local,a.yaw);wps.push_back(p);worldWaypoints.push_back(vecJson(p));}
+            bool clear=true;
+            for(size_t i=1;i<wps.size()&&clear;++i){
+                const V3 from=wps[i-1],to=wps[i];const int steps=std::max(1,int(std::ceil(flatLength(to-from)/.4f)));
+                for(int s=0;s<=steps&&clear;++s){const V3 p=from+(to-from)*(float(s)/steps);Matrix capsule=transform(p+V3{0,.9f,0},{.84f,1.8f,.84f},a.yaw);if(g.collision.overlapBox(capsule,a.token))clear=false;}
+            }
+            if(!clear)continue;
+            for(const auto& p:wps){Matrix capsule=transform(p+V3{0,.9f,0},{.84f,1.8f,.84f},a.yaw);if(g.collision.overlapBox(capsule,a.token)){clear=false;break;}}
+            if(!clear)continue;
+            a.anchor=a.pos;a.lastProgress=g.time;
+            fixture=Json{{"position",vecJson(a.pos)},{"yaw",a.yaw},{"yaw_degrees",direction*15},{"attempt",attempt},{"direction",direction},
+                {"npc_interference_disabled",true},{"player_radius_m",.42f},{"layout",config},{"waypoints",worldWaypoints},
+                {"corridor_gap_m",2*(layout.lateral-layout.width*.5f)},
+                {"search","deterministic nav sample + 24 yaw directions; validated by loadStaggeredObstacles and capsule path clearance"}};
+            clearStaggeredObstacles();
+            return true;
+        }
+    }
+    a.pos=originalPosition;a.yaw=originalYaw;g.collision.teleport(a.body,originalPosition);g.pose();clearStaggeredObstacles();
+    fixture={{"error","no validated staggered-obstacle fixture found"}};
+    return false;
+}
+Json Encounter::staggeredObstacleTest(){
+    auto& g=*impl;auto& a=g.actors[Impl::PlayerIndex];Json checks=Json::array();
+    setAutopilot(false);
+    const auto require=[&](bool good,const std::string& message){if(!good)throw std::runtime_error("Staggered obstacle regression: "+message);checks.push_back(message);};
+    const auto mapObjects=g.map.objects.size();
+    Json fixture;
+    require(prepareStaggeredObstacleDemo(fixture),"deterministic staggered-layout fixture found");
+    const V3 start=jsonVec(fixture["position"]);const float yaw=fixture["yaw"];
+    const auto loaded=loadStaggeredObstacles(fixture["layout"]);
+    require(loaded.value("loaded",false),"layout loads through the scene-edit API");
+    require(loaded.value("count",0)==3,"exactly three obstacles are created");
+    const auto state=staggeredObstacleState();
+    require(state["active"]==3,"three obstacles remain active");
+    const auto& obstacles=state["obstacles"];
+    std::array<uint32_t,3> tokens{};std::array<V3,3> positions{};std::array<V3,3> sizes{};
+    for(int i=0;i<3;++i){tokens[i]=obstacles[i]["token"].get<uint32_t>();positions[i]=jsonVec(obstacles[i]["position"]);sizes[i]=jsonVec(obstacles[i]["size"]);}
+    require(tokens[0]!=tokens[1]&&tokens[1]!=tokens[2]&&tokens[0]!=tokens[2],"three independent obstacle tokens");
+    require(std::abs(sizes[0].x-1.6f)<1e-4f&&std::abs(sizes[0].y-1.8f)<1e-4f&&std::abs(sizes[0].z-.35f)<1e-4f,"configured obstacle dimensions are applied");
+    std::array<V3,3> local{};
+    for(int i=0;i<3;++i)local[i]=rotate(positions[i]-start,-yaw);
+    require(local[0].x<-.5f&&local[1].x>.5f&&local[2].x<-.5f,"layout alternates left/right/left");
+    require(std::abs(std::abs(local[0].x)-std::abs(local[1].x))<1e-3f&&std::abs(std::abs(local[1].x)-std::abs(local[2].x))<1e-3f,"lateral offsets match");
+    require(std::abs(local[1].z-local[0].z-3.f)<1e-3f&&std::abs(local[2].z-local[1].z-3.f)<1e-3f,"longitudinal spacing is three metres");
+    for(int i=0;i<3;++i)for(int j=i+1;j<3;++j){const V3 d=positions[i]-positions[j];require(flatLength(d)>1.0f,"obstacle volumes do not interpenetrate");}
+    const V3 sideDir=rotate(V3{1,0,0},yaw);
+    for(int i=0;i<3;++i){const V3 c=positions[i]+V3{0,1.f,0};auto hit=g.collision.ray(c-sideDir*(sizes[i].x*.65f),c+sideDir*(sizes[i].x*.65f),a.token);require(hit.hit&&hit.token==tokens[i],"obstacle "+std::to_string(i)+" collides");}
+    // Capsule clearance along the whole deterministic route, not just the waypoints.
+    const auto& wps=fixture["waypoints"];bool clear=true;
+    for(size_t i=1;i<wps.size()&&clear;++i){
+        const V3 from=jsonVec(wps[i-1]),to=jsonVec(wps[i]);const int steps=std::max(1,int(std::ceil(flatLength(to-from)/.4f)));
+        for(int s=0;s<=steps&&clear;++s){const V3 p=from+(to-from)*(float(s)/steps);Matrix capsule=transform(p+V3{0,.9f,0},{.84f,1.8f,.84f},yaw);if(g.collision.overlapBox(capsule,a.token))clear=false;}
+    }
+    require(clear,"player capsule has clearance along the route");
+    // Drive with ordinary local input only; no per-frame position writes.
+    a.pos=start;a.yaw=yaw;a.velocity={};a.grounded=true;a.pitch=0;a.crouch=false;a.ads=false;a.action.clear();a.actionEnd=a.reloadEnd=0;g.collision.teleport(a.body,start);
+    size_t target=0;double startTime=g.time,maxStep=0,pathLength=0;const size_t maxTicks=1200;
+    for(size_t tick=0;tick<maxTicks&&target<wps.size();++tick){
+        V3 to=jsonVec(wps[target])-a.pos;to.y=0;const float distance=to.length();
+        if(distance<.35f){++target;continue;}
+        const V3 dir=to.normalized();CombatInput in;in.forward=dot(dir,forward(a.yaw));in.right=dot(dir,rotate({1,0,0},a.yaw));
+        const V3 before=a.pos;advance(1.f/120,in);const double step=flatLength(a.pos-before);maxStep=std::max(maxStep,step);pathLength+=step;
+    }
+    require(target==wps.size(),"ordinary movement reaches the finish waypoint (target="+std::to_string(target)+"/"+std::to_string(wps.size())+", pos="+std::to_string(a.pos.x)+","+std::to_string(a.pos.z)+", sim="+std::to_string(g.time-startTime)+")");
+    require(g.time-startTime<=9.0,"route completes within nine simulation seconds");
+    require(maxStep<=.05,"no teleport in the driven trajectory");
+    require(pathLength>=10.0,"driven trajectory covers the route");
+    // The player cover singleton stays independent from the three layout objects.
+    a.pos=start;a.yaw=yaw;a.velocity={};a.grounded=true;g.collision.teleport(a.body,start);g.resetCover();g.coverReady=0;
+    CombatInput h;h.cover=true;advance(1.f/120,h);
+    require(g.wall.token!=0,"temporary player cover still works alongside the layout");
+    const uint32_t wallToken=g.wall.token;advance(1.f/120,h);
+    require(g.wall.token&&g.wall.token!=wallToken,"temporary cover replacement is unchanged");
+    require(staggeredObstacleState()["active"]==3,"cover replacement does not remove layout obstacles");
+    for(int i=0;i<3;++i){const V3 c=positions[i]+V3{0,1.f,0};auto hit=g.collision.ray(c-sideDir*(sizes[i].x*.65f),c+sideDir*(sizes[i].x*.65f),a.token);require(hit.hit&&hit.token==tokens[i],"layout collision survives cover replacement");}
+    clearStaggeredObstacles();
+    require(staggeredObstacleState()["active"]==0,"layout can be cleared");
+    const V3 c0=positions[0]+V3{0,1.f,0};auto gone=g.collision.ray(c0-sideDir*(sizes[0].x*.65f),c0+sideDir*(sizes[0].x*.65f),a.token);require(!gone.hit||gone.token!=tokens[0],"cleared obstacle collision is released");
+    bool drawn=false;for(const auto& d:g.draw())for(uint32_t t:tokens)if(d.instance.objectToken==t)drawn=true;
+    require(!drawn,"cleared obstacles are no longer drawn");
+    require(g.map.objects.size()==mapObjects,"map objects are untouched");
+    return {{"passed",true},{"checks",checks},{"fixture",fixture},{"layout",loaded},{"driven",{{"route_waypoints",wps.size()},{"seconds",g.time-startTime},{"max_step_m",maxStep},{"path_length_m",pathLength}}},{"tokens",{tokens[0],tokens[1],tokens[2]}}};
+}
